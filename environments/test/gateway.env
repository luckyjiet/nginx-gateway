APP_ENV=test
GATEWAY_CONTAINER_NAME=gateway-nginx
EDGE_NETWORK_NAME=rwat-edge
OPENCOIN_WEB_ROOT=/var/www/opencoin
OPENCOIN_WEB_ENV=test
WITTGENS_WEB_ROOT=/var/www/wittgens
WITTGENS_WEB_ENV=test

OPENCOIN_DOMAIN=uniamm.com
RWAT_FRONTEND_DOMAIN=wittgens.cloud
RWAT_API_DOMAIN=api.wittgens.cloud
RWAT_ADMIN_DOMAIN=admin.wittgens.cloud
RWAT_FRONTEND_ROOT=/var/www/wittgens/${WITTGENS_WEB_ENV}
RWAT_API_UPSTREAM=http://rwat-go-server:8000
RWAT_ADMIN_UPSTREAM=http://rwat-admin-ui:80

OPENCOIN_CERT_NAME=uniamm.com
OPENCOIN_CERT_DOMAINS="${OPENCOIN_DOMAIN}"
RWAT_CERT_NAME=wittgens.cloud
RWAT_CERT_DOMAINS="${RWAT_FRONTEND_DOMAIN} ${RWAT_API_DOMAIN} ${RWAT_ADMIN_DOMAIN}"
CERT_GROUP_KEYS="OPENCOIN_CERT RWAT_CERT"
